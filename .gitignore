# Pre-crop backups of report cover-pages — not referenced by any tool, kept
# locally as an archive of the originals.
assets/Reports/_originals-pre-crop/

# Local snapshots and one-time seed SQL — generated locally during migration,
# not part of the deploy. Already applied to Supabase; kept locally only as
# a short-term rollback aid. Re-creatable from the legacy Netlify site.
scripts/reports-snapshots/
scripts/clock-state-snapshot.json
scripts/presentation-state-snapshot.json
scripts/documents-state-snapshot.json
scripts/seed-clock-state.sql
scripts/seed-presentation-state.sql
scripts/seed-documents-state.sql
scripts/seed-reports-state-*.sql

# Scrabble seed input — copyright-encumbered word lists are dropped here
# locally and fed into Supabase via scripts/seed-scrabble-words.mjs. The
# dictionary lives in the scrabble_words table once seeded; the source
# file isn't needed at runtime, so we don't ship it with the repo.
data/scrabble-words.txt

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local scheduled-task run logs (e.g. the monthly JSA Job Creation ingest,
# run on this PC because jobsandskills.gov.au blocks the CI runner IPs).
logs/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp
*~

# Local env / secrets (none expected, but defence in depth)
.env
.env.local
.env.*.local

# Claude Code local settings — IDE-side permissions / preferences,
# not meant to be shared. Harmless content but clutters the repo.
# (.claude/skills/ IS shared — the brand skill lives there, per the brand
# repo's TEAM_SETUP.md; a child of an ignored DIRECTORY can't be re-included,
# hence ignore children via .claude/* + negate skills.)
.claude/*
!.claude/skills/

# Supabase CLI local state — version cache + linked-project pointer.
# Machine-specific; regenerated on `supabase link`.
supabase/.temp/
supabase/.branches/

# Local-only confidential docs (the architecture PDF + CEO email PDF), their
# temp HTML sources, and the local render helper — never committed to the
# public repo. Patterns are generic so the filenames don't appear here either.
/*.pdf
docs/_*.html
scripts/_render-doc.mjs

# Laptop-transfer luggage: backup of the home ~/.claude (memory/settings) and
# the setup checklist. Local-only; delete both once the new laptop is set up.
_claude-home-backup/
NEW-LAPTOP-SETUP.md

# PP-OS redesign: local test artifacts (baselines are binary, machine-local)
baselines/*
!baselines/README.md

# local static-server config (serve) — machine-local, not deployed
serve.json

# Local working scratch — one-off scripts, deck builders, QA captures, backups.
# Never part of the deploy; was accidentally swept in once via `git add -A`.
scratch/

# Brand logo source assets — kept locally, not served by any tool.
Performance Property Logo's/

# Local office docs + doc-generation helper (the .gs pushed to Apps Script).
*.docx
docs/_technical-doc-to-google-docs.gs
