# Copy to .env and fill in real values for local testing of scripts/render-reports.mjs.
# In production these are GitHub Secrets — see .github/workflows/render-online-reports.yml.

# Your Supabase project URL — visible at Project Settings → API.
SUPABASE_URL=https://cannojsxduvlewimwoxa.supabase.co

# Service-role key (Project Settings → API → Service Role).
# DO NOT commit this; it grants full database + storage write.
SUPABASE_SERVICE_ROLE_KEY=

# Anon/publishable key — used only by the renderer to call
# auth.signInWithPassword. The service-role key can't be used for that.
SUPABASE_ANON_KEY=

# Service account that opens the report page (Tier 2 staff is enough).
# Create this user in Supabase Auth → Users, then update profiles.tier=staff.
PDF_RENDERER_EMAIL=pdf-renderer@performanceproperty.com.au
PDF_RENDERER_PASSWORD=

# Public URL hosting tools/online-reports.html. The renderer hits
# {APP_URL}/tools/online-reports.html?region=…&exportMode=1[&lite=1].
# No trailing slash.
APP_URL=
